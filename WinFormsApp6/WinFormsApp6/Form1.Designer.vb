    Private Sub Button2_Click(sender As Object, e As EventArgs) Handles Button2.Click
        Dim a1, b1, c1 As UInteger, fin1 As UInteger
        a1 = Val(TextBox5.Text) : b1 = Val(TextBox6.Text) : c1 = Val(TextBox7.Text)
        If (a1 = b1) Or (b1 = c1) Or (a1 = c1) Then
            MsgBox("三數不可相同", 0)
        End If
        If (a1 > b1) And (a1 > c1) Then
            fin1 = a1
        End If
        If (b1 > a1) And (b1 > c1) Then
            fin1 = b1
        End If
        If (c1 > b1) And (c1 > a1) Then
            fin1 = c1
        End If
        TextBox8.Text = fin1
    End Sub

