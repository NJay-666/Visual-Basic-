    Private Sub Button4_Click(sender As Object, e As EventArgs) Handles Button4.Click
        Dim month As Integer, senson As String
        month = Val(TextBox11.Text)
        If (month > 12) Or (month = 0) Then
            MsgBox("沒有這個月份", 0)
        End If
        Select Case month
            Case month = 1 To 3
                senson = "春季"
            Case month = 4 To 6
                senson = "夏季"
            Case month = 7 To 9
                senson = "秋季"
            Case month = 10 To 12
                senson = "冬季"
        End Select
        TextBox12.Text = senson
    End Sub
