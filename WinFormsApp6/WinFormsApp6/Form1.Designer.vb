    Private Sub Button3_Click(sender As Object, e As EventArgs) Handles Button3.Click
        Dim doo As UInteger, cost As Double
        doo = Val(TextBox9.Text)
        If doo <= 10 Then
            cost = doo * 7.35
        ElseIf doo <= 30 Then
            cost = doo * 9.45 - 21
        ElseIf doo <= 50 Then
            cost = doo * 11.55 - 84
        Else
            cost = doo * 12.075 - 110.25
        End If
        TextBox10.Text = cost
    End Sub

