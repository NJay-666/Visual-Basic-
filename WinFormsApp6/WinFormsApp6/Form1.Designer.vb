    Private Sub Button1_Click(sender As Object, e As EventArgs) Handles Button1.Click
        Dim a, b, c As UInteger, fin As String
        a = Val(TextBox1.Text) : b = Val(TextBox2.Text) : c = Val(TextBox3.Text)
        If a + b > c Then
            If b + c > a Then
                If a + c > b Then
                    fin = "是"
                Else
                    fin = "否"
                End If
            Else
                fin = "否"
            End If
        Else
            fin = "否"
        End If
        TextBox4.Text = fin
    End Sub

